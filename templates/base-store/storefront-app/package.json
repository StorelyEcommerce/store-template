{
  "name": "storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./theme/assets/styles.css -o ./theme/assets/index.css --minify",
    "watch:css": "tailwindcss -i ./theme/assets/styles.css -o ./theme/assets/index.css --watch",
    "dev": "npm run build:css && node server.js",
    "start": "npm run build:css && node server.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.18.2",
    "liquidjs": "^10.9.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.1",
    "tailwindcss": "^3.4.18"
  }
}